{
    "name": "lionix/envclient",
    "description": "Manage and validate Laravel environment variables with artisan commands, validation rules and a fluent client.",
    "keywords": [
        "laravel",
        "env",
        "dotenv",
        "environment",
        "validation",
        "artisan",
        "lionix"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Lionix Team",
            "email": "packages@lionix-team.com"
        },
        {
            "name": "Anastas Vartanyan",
            "email": "vaawebdev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Lionix\\EnvClient\\": "src/app"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lionix\\EnvClient\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lionix\\EnvClient\\Providers\\EnvClientServiceProvider"
            ],
            "aliases": {
                "Lionix\\EnvClient": "Lionix\\EnvClient\\Services\\EnvClient",
                "Lionix\\EnvGetter": "Lionix\\EnvClient\\Services\\EnvGetter",
                "Lionix\\EnvSetter": "Lionix\\EnvClient\\Services\\EnvSetter",
                "Lionix\\EnvValidator": "Lionix\\EnvClient\\Services\\EnvValidator"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
